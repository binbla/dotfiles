#!/usr/bin/env bash
# 实验室 Ubuntu SSH 登录提示（MOTD）
# 分区：欢迎 / Notes / 通知 / 使用指南
# 安装到 /etc/update-motd.d/60-lab-guide

# 格式：挂载路径|显示名称|用途描述
DISKS=(
  "/|系统根盘|系统及 Conda 缓存"
  "/home|HOME 分区|用户配置和主目录"
  "/data/disk0|公共数据盘|数据集、预训练模型"
  "/data/disk1|用户工作盘|个人工作空间"
)
# 格式：工具名称|类型|可执行文件路径模式
TOOLCHAINS=(
  "CUDA Toolkit|nvcc|/usr/local/cuda*/bin/nvcc"
  "GCC|gcc|/usr/bin/gcc*"
  "G++|g++|/usr/bin/g++*"
  "Clang|clang|/usr/bin/clang*"
  "CMake|cmake|/usr/bin/cmake"
  "Ninja|ninja|/usr/bin/ninja"
)

RESET=$'\033[0m'
CYAN=$'\033[1;36m'
BLUE=$'\033[1;34m'
GREEN=$'\033[1;32m'
YELLOW=$'\033[1;33m'
DIM=$'\033[2m'
BOLD=$'\033[1m'

# 允许显式禁用颜色
if [[ -n "${NO_COLOR:-}" ]]; then
  RESET='' CYAN='' BLUE='' GREEN=''
  YELLOW='' RED='' DIM='' BOLD=''
fi


line() { printf '%b\n' "${DIM}────────────────────────────────────────────────────────────${RESET}"; }
section() { printf '\n%b%s%b\n' "$BLUE" "$1" "$RESET"; }
cmd() { printf '  %-12s %b%s%b\n' "$1" "$GREEN" "$2" "$RESET"; }
# 从指定二进制提取版本
tool_version() {
  local type="$1" binary="$2"

  case "$type" in
    nvcc)
      "$binary" --version 2>/dev/null |
        sed -n 's/.*release \([0-9.]*\).*/\1/p' |
        head -1
      ;;
    gcc|g++)
      "$binary" -dumpfullversion -dumpversion 2>/dev/null
      ;;
    clang)
      "$binary" --version 2>/dev/null |
        sed -n 's/.*version \([0-9.]*\).*/\1/p' |
        head -1
      ;;
    cmake)
      "$binary" --version 2>/dev/null |
        awk 'NR==1 {print $3}'
      ;;
    ninja)
      "$binary" --version 2>/dev/null | head -1
      ;;
  esac
}

module_welcome() {
  printf '\n%b🌟 欢迎使用实验室算力服务器%b\n' "$CYAN" "$RESET"
  printf '   Ubuntu · GPU 计算 · 科学计算与图像研究\n'
  line
}
module_disks() {
  section '💾 磁盘状态'

  local entry path name description info

  for entry in "${DISKS[@]}"; do
    IFS='|' read -r path name description <<< "$entry"

    if [[ ! -d "$path" ]] || ! mountpoint -q "$path"; then
      printf '  📁 %s：%b尚未挂载%b (%s)\n' \
        "$name" "$YELLOW" "$RESET" "$description"
      continue
    fi

    info=$(df -hP "$path" 2>/dev/null | awk 'NR==2 {
      printf "%s / %s (%s)", $3, $2, $5
    }')

    printf '  📁 %s：%b%s%b (%s)\n' \
      "$name" "$CYAN" "${info:-读取失败}" "$RESET" "$description"
  done
}

module_sysinfo() {
  section '📊 系统状态'

  local hostname uptime_info load cpu_info
  local mem_used mem_total mem_pct online_users

  hostname=$(hostname -s)
  uptime_info=$(uptime -p | sed 's/^up //')
  load=$(awk '{print $1, $2, $3}' /proc/loadavg)
  cpu_info=$(nproc)

  read -r mem_total mem_used mem_pct < <(
    free -m | awk '/^Mem:/ {
      printf "%.1fG %.1fG %.0f%%\n", $2/1024, $3/1024, $3/$2*100
    }'
  )

  # 统计在线用户，并包含当前登录用户
  online_users=$(
    loginctl list-users --no-legend 2>/dev/null \
      | awk '$1 ~ /^[0-9]+$/ {print $2}' \
      | sort -u \
      | wc -l
  )

  printf '  🖥  主机名称：%b%s%b\n' "$CYAN" "$hostname" "$RESET"
  printf '  ⏱  运行时间：%s\n' "$uptime_info"
  printf '  ⚙  CPU 线程：%s\n' "$cpu_info"
  printf '  📈 系统负载：%b%s%b (1/5/15 分钟)\n' \
    "$GREEN" "$load" "$RESET"
  printf '  🧠 内存使用：%s / %s (%s)\n' \
    "$mem_used" "$mem_total" "$mem_pct"
  printf '  👥 在线用户：%s\n' "$online_users"
}
module_toolchain() {
  section '🛠 工具链版本'

  local cache=/var/cache/lab-motd/toolchains.txt
  local name versions

  if [[ ! -r "$cache" ]]; then
    printf '  %b工具链信息尚未初始化%b\n' "$YELLOW" "$RESET"
    return 0
  fi

  while IFS='|' read -r name versions; do
    [[ -n "$name" ]] || continue
    printf '  %-8s %b%s%b\n' \
      "$name" "$CYAN" "$versions" "$RESET"
  done < "$cache"

  printf '  %b* 系统默认版本%b\n' "$YELLOW" "$RESET"
}

module_notes() {
  section '📌 使用须知'
  printf '  📁 公共共享区：%b/data/disk0/%b（所有数据集和预训练模型存放位置）\n' "$CYAN" "$RESET"
  printf '  📂 用户数据区：%b/data/disk1/%b（你将在此展开你的Work Space）\n' "$CYAN" "$RESET"
  printf '  🔒 请勿修改其他用户文件或公共软件环境。\n'
}

module_notice() {
  section '📣 通知'
  printf '  ✉  如有未读本地邮件，请运行：%bmail%b\n' "$GREEN" "$RESET"
  # 管理员可选维护纯文本公告；不执行公告中的任何内容。
  NOTICE_FILE='/etc/lab-motd/notice.txt'
  if [ -r "$NOTICE_FILE" ] && [ -s "$NOTICE_FILE" ]; then
    printf '  %b实验室公告：%b\n' "$YELLOW" "$RESET"
    sed 's/^/    /' "$NOTICE_FILE"
  else
    printf '  暂无其他公告。\n'
  fi
}

module_conda() {
  section '🐍 使用指南 · Conda'
  printf '  推荐使用 %bPython 3.12%b，所有用户使用独立虚拟环境。\n' "$GREEN" "$RESET"
  printf '  %b请尽量使用mamba替代pip安装软件包，可以有效利用缓存机制。%b\n' "$YELLOW" "$RESET"
  printf '\n'
  cmd '创建环境' 'mamba create -n myenv python=3.12'
  cmd '激活环境' 'conda activate myenv'
  cmd '安装 PyTorch (GPU)' 'mamba install pytorch-gpu -c conda-forge'
  printf '\n'
  printf '  %b更多帮助：%bconda --help | mamba --help | conda create --help\n' \
    "$YELLOW" "$RESET"
}



main() {
  module_welcome
  module_sysinfo
  module_toolchain
  module_disks
  module_notes
  module_notice
  line
  module_conda
  printf '\n'
  line
  printf '\n'
}

main

