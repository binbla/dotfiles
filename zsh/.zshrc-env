# ==============================================================================
# Zsh Environment
# ==============================================================================
#
# 负责：
#   - 基础目录
#   - Cache
#   - PATH
#   - Editor
#   - Zsh Options
#   - History
#
# 不负责：
#   - Oh My Zsh
#   - Plugins
#   - Completion
#   - Key bindings
#   - Prompt
# ==============================================================================


# ------------------------------------------------------------------------------
# 基础目录
# ------------------------------------------------------------------------------

# Oh My Zsh 安装目录
export ZSH="/usr/share/oh-my-zsh"

# Arch Linux 系统安装的 Zsh 插件目录
export ZSH_PLUGINS_DIR="/usr/share/zsh/plugins"

# dotfiles 根目录
export DOTFILES_DIR="$HOME/dotfiles"

# 当前使用 GNU Stow 将：
#
#   ~/dotfiles/zsh/.zshrc
#
# 链接为：
#
#   ~/.zshrc
#
# 这里设置 ZDOTDIR 主要用于统一引用其他 Zsh 配置和数据文件。
export ZDOTDIR="$DOTFILES_DIR/zsh"


# ------------------------------------------------------------------------------
# Cache
# ------------------------------------------------------------------------------

# Zsh 运行时缓存统一放到 ~/.cache/zsh。
export ZSH_CACHE_DIR="${XDG_CACHE_HOME:-$HOME/.cache}/zsh"

[[ -d "$ZSH_CACHE_DIR" ]] || mkdir -p "$ZSH_CACHE_DIR"

# compinit 补全缓存
export ZSH_COMPDUMP="$ZSH_CACHE_DIR/.zcompdump-$ZSH_VERSION"


# ------------------------------------------------------------------------------
# PATH
# ------------------------------------------------------------------------------

# Zsh 的 path 数组与 PATH 自动同步。
#
# -U：
#   自动删除重复路径。
typeset -U path PATH

[[ -d "$HOME/.local/bin" ]] && path=("$HOME/.local/bin" $path)
[[ -d "$HOME/.bin" ]]       && path=("$HOME/.bin" $path)


# ------------------------------------------------------------------------------
# Editor
# ------------------------------------------------------------------------------

export EDITOR="vim"
export VISUAL="vim"


# ------------------------------------------------------------------------------
# Zsh Options
# ------------------------------------------------------------------------------

# AUTO_CD
#   输入目录名即可进入目录。
#
# EXTENDED_GLOB
#   开启 Zsh 扩展 glob。
#
# COMPLETE_ALIASES
#   补全 alias 本身，而不是先展开 alias。
setopt AUTO_CD EXTENDED_GLOB COMPLETE_ALIASES

# 禁止终端蜂鸣
unsetopt BEEP


# ------------------------------------------------------------------------------
# History
# ------------------------------------------------------------------------------

# 历史文件
HISTFILE="$ZDOTDIR/.zsh_history"

# 当前 Shell 内存中保存的最大历史数量
HISTSIZE=100000

# History 文件最多保存的记录数量
SAVEHIST=100000


# 多个 Shell 实时共享 history。
#
# SHARE_HISTORY 本身已经包含增量写入行为，
# 因此不再同时启用 INC_APPEND_HISTORY。
setopt SHARE_HISTORY

# 连续重复命令不保存
setopt HIST_IGNORE_DUPS

# 新命令加入 history 时，
# 删除之前已有的相同命令。
setopt HIST_IGNORE_ALL_DUPS

# 写入 history 文件时不保存重复项
setopt HIST_SAVE_NO_DUPS

# 删除命令中过多的空格
setopt HIST_REDUCE_BLANKS

# 从 history 中调出的命令先放到命令行，
# 不直接执行。
setopt HIST_VERIFY

# 以空格开头的命令不写入 history。
#
# 可用于临时执行包含 token/password 的命令。
setopt HIST_IGNORE_SPACE

# 代理配置变量（请根据实际情况修改）
# 默认值：SOCKS5 代理
DEFAULT_PROXY_HOST="localhost"
DEFAULT_SOCKS5_PORT="7890"
DEFAULT_HTTP_PORT="7890"  # HTTP/HTTPS 代理端口（如 Clash 的 HTTP 端口）
